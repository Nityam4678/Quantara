PORT=3000
ENGINE_ADAPTER_PATH=..\..\.quantara-build\quantara_engine_adapter.exe
AI_SERVICE_URL=http://127.0.0.1:8000
ENGINE_CAPACITY=1000000
ENGINE_REQUEST_TIMEOUT_MS=5000
HTTP_REQUEST_TIMEOUT_MS=15000
JSON_BODY_LIMIT=64kb
AUTH_REQUIRED=false
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_SECONDS=3600
AUTH_USERNAME=admin
AUTH_PASSWORD=replace-with-a-long-password
CORS_ORIGINS=http://127.0.0.1:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
INTERNAL_SERVICE_TOKEN=replace-with-a-long-internal-token
